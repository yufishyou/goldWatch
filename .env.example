# 复制为 .env 后填写；不要提交到 git。
# 只填你实际使用的那个通道即可。

# Server酱：https://sct.ftqq.com/  → SendKey
SERVERCHAN_SENDKEY=

# PushPlus：https://www.pushplus.plus/  → token
PUSHPLUS_TOKEN=

# WxPusher：https://wxpusher.zjiecode.com/  → APP_TOKEN 和 UID
WXPUSHER_APP_TOKEN=
WXPUSHER_UID=

# 企业微信群机器人：群设置 → 群机器人 → Webhook 地址
WECOM_WEBHOOK_URL=
